<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GalgameManager.Views.AnnualReportSubPage6"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prefab="using:GalgameManager.Views.Prefab"
    xmlns:viewModels="using:GalgameManager.ViewModels" xmlns:behaviors="using:GalgameManager.Behaviors"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="在每个月，我最喜欢..."
                   Style="{ThemeResource SubtitleTextBlockStyle}"
                   HorizontalAlignment="Center"
                   Margin="0,20,0,20"/>

        <GridView Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.MonthlyBestGames}"
                  SelectionMode="None"
                  HorizontalAlignment="Center">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="viewModels:MonthlyBestGame">
                    <Grid Width="200" Height="330" Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock 
                                   FontSize="24"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10">
                            <Run Text="{x:Bind Month}"/>
                            <Run Text="月"/>
                        </TextBlock>
                        
                        <prefab:GalgamePrefab Grid.Row="1"
                                              Galgame="{x:Bind Game}"
                                              ImageStretch="UniformToFill"/>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>

