<?xml version="1.0" encoding="utf-8"?>

<ContentDialog
    x:Class="GalgameManager.Views.Dialog.BatchChangePlayStatusDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converter="using:GalgameManager.Helpers.Converter"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:GalgameManager.Models"
    mc:Ignorable="d"
    Style="{ThemeResource DefaultContentDialogStyle}">

    <ContentDialog.Resources>
        <converter:ImagePathConverter x:Key="ImagePathConverter" />
    </ContentDialog.Resources>

    <Grid x:Name="LayoutRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                <TextBlock x:Uid="ChangePlayStatusDialog_Status" VerticalAlignment="Center" />
                <ComboBox x:Name="PlayStatusBox" MinWidth="100" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <TextBlock x:Uid="ChangePlayStatusDialog_Rating" VerticalAlignment="Center" />
                <ComboBox x:Name="RateBox" MinWidth="100" />
            </StackPanel>
        </Grid>

        <ListView Grid.Row="1"
                  Margin="{StaticResource SmallTopMargin}"
                  ItemsSource="{Binding SelectedGalgames}"
                  SelectionMode="None"
                  MaxHeight="300">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Galgame">
                    <Grid Padding="4,2" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="57" Height="80" CornerRadius="6">
                            <Border.Background>
                                <ImageBrush ImageSource="{x:Bind ImagePath.Value, Converter={StaticResource ImagePathConverter}}"
                                            Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{x:Bind Name.Value}"
                                       Style="{ThemeResource BodyTextStyle}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Developer.Value}"
                                       Style="{ThemeResource DescriptionTextStyle}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="15" Margin="0 20 0 0">
            <CheckBox x:Name="BgmCheckBox" x:Uid="ChangePlayStatusDialog_SyncToBgm" />
            <CheckBox x:Name="VndbCheckBox" x:Uid="ChangePlayStatusDialog_SyncToVNDB" />
            <CheckBox x:Name="PrivateCheckBox" x:Uid="ChangePlayStatusDialog_Private" />
        </StackPanel>
    </Grid>
</ContentDialog>
