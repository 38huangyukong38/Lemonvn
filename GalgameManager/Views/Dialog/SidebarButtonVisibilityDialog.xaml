<ContentDialog
    x:Class="GalgameManager.Views.Dialog.SidebarButtonVisibilityDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:GalgameManager.Models"
    xmlns:converter="using:GalgameManager.Helpers.Converter"
    mc:Ignorable="d"
    x:Uid="SidebarButtonVisibilityDialog"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    Style="{ThemeResource DefaultContentDialogStyle}">

    <ContentDialog.Resources>
        <converter:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </ContentDialog.Resources>

    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16">
            <TextBlock x:Uid="SidebarButtonVisibilityDialog_Description"
                       Style="{StaticResource DescriptionTextStyle}"
                       TextWrapping="Wrap"/>

            <StackPanel Spacing="8">
                <TextBlock x:Uid="SidebarButtonVisibilityDialog_MenuHeader"
                           Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                <ItemsRepeater ItemsSource="{x:Bind MenuButtons, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Vertical" Spacing="6"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:SidebarBtnSettingItem">
                            <CheckBox IsChecked="{x:Bind IsVisible, Mode=TwoWay}"
                                      IsEnabled="{x:Bind CanToggle, Mode=OneWay}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{x:Bind Title}"/>
                                    <TextBlock Text="{x:Bind Description}"
                                               Visibility="{x:Bind Description, Converter={StaticResource StringToVisibilityConverter}}"
                                               Style="{StaticResource DescriptionTextStyle}"/>
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock x:Uid="SidebarButtonVisibilityDialog_FooterHeader"
                           Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                <ItemsRepeater ItemsSource="{x:Bind FooterButtons, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Vertical" Spacing="6"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:SidebarBtnSettingItem">
                            <CheckBox IsChecked="{x:Bind IsVisible, Mode=TwoWay}"
                                      IsEnabled="{x:Bind CanToggle, Mode=OneWay}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{x:Bind Title}"/>
                                    <TextBlock Text="{x:Bind Description}"
                                               Visibility="{x:Bind Description, Converter={StaticResource StringToVisibilityConverter}}"
                                               Style="{StaticResource DescriptionTextStyle}"/>
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
