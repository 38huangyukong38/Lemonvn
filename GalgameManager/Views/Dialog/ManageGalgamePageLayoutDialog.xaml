<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="GalgameManager.Views.Dialog.ManageGalgamePageLayoutDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GalgameManager.Views.Dialog"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:models="using:GalgameManager.Models"
    xmlns:converter="using:GalgameManager.Helpers.Converter"
    Style="{ThemeResource DefaultContentDialogStyle}">

    <ContentDialog.Resources>
        <converter:EnumToStringConverter x:Key="EnumStringConverter"/>
        <converter:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <converter:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </ContentDialog.Resources>

    <StackPanel Spacing="8" HorizontalAlignment="Stretch" Margin="0,0,0,0">
        <!-- 标题和说明 -->
        <TextBlock x:Uid="ManageGalgamePageLayoutDialog_Description"
                   Style="{StaticResource DescriptionTextStyle}"/>

        <!-- 使用ListView并限制高度 -->
        <ListView x:Name="SettingsListView"
                  SelectionMode="None"
                  IsItemClickEnabled="False"
                  MaxHeight="320" MinWidth="400">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="MinHeight" Value="0"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.Items>
                <!-- 标题设置部分-->
                <StackPanel Spacing="0" HorizontalAlignment="Stretch">
                    <Grid ColumnSpacing="12" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   x:Uid="ManageGalgamePageLayoutDialog_PrimaryTitle"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"/>
                        <ComboBox Grid.Column="1"
                                  x:Name="PrimaryTitleComboBox"
                                  ItemsSource="{x:Bind PrimaryTitleTypes}"
                                  SelectedItem="{x:Bind GalgamePagePrimaryTitleType, Mode=TwoWay}"
                                  HorizontalAlignment="Right"
                                  MinWidth="120">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:DisplayName">
                                    <TextBlock Text="{x:Bind Converter={StaticResource EnumStringConverter}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <Grid ColumnSpacing="12" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   x:Uid="ManageGalgamePageLayoutDialog_SecondaryTitle"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"/>
                        <ComboBox Grid.Column="1"
                                  x:Name="SecondaryTitleComboBox"
                                  ItemsSource="{x:Bind SecondaryTitleTypes}"
                                  SelectedItem="{x:Bind GalgamePageSecondaryTitleType, Mode=TwoWay}"
                                  HorizontalAlignment="Right"
                                  MinWidth="120">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:DisplayName">
                                    <TextBlock Text="{x:Bind Converter={StaticResource EnumStringConverter}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </StackPanel>

                <!-- 分隔线 -->
                <Rectangle Height="1" Margin="0,8,0,8"
                           Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                <!-- 新版界面设置组 -->
                <StackPanel Spacing="0" HorizontalAlignment="Stretch">
                    <!-- 单独选项：画师 -->
                    <Grid ColumnSpacing="12" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   x:Uid="ManageGalgamePageLayoutDialog_ShowPainter"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"/>
                        <ToggleSwitch Grid.Column="1"
                                      IsOn="{x:Bind GalgamePageNewLayout_ShowPainter, Mode=TwoWay}"
                                      HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- 单独选项：声优 -->
                    <Grid ColumnSpacing="12" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   x:Uid="ManageGalgamePageLayoutDialog_ShowSeiyu"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"/>
                        <ToggleSwitch Grid.Column="1"
                                      IsOn="{x:Bind GalgamePageNewLayout_ShowSeiyu, Mode=TwoWay}"
                                      HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- 单独选项：剧本 -->
                    <Grid ColumnSpacing="12" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   x:Uid="ManageGalgamePageLayoutDialog_ShowWriter"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"/>
                        <ToggleSwitch Grid.Column="1"
                                      IsOn="{x:Bind GalgamePageNewLayout_ShowWriter, Mode=TwoWay}"
                                      HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- 单独选项：音乐 -->
                    <Grid ColumnSpacing="12" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   x:Uid="ManageGalgamePageLayoutDialog_ShowMusician"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"/>
                        <ToggleSwitch Grid.Column="1"
                                      IsOn="{x:Bind GalgamePageNewLayout_ShowMusician, Mode=TwoWay}"
                                      HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- 单独选项：显示背景图 -->
                    <Grid ColumnSpacing="12" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   x:Uid="ManageGalgamePageLayoutDialog_ShowBackground"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"/>
                        <ToggleSwitch Grid.Column="1"
                                      x:Name="GalgamePageNewLayout_ShowBackgroundToggle"
                                      IsOn="{x:Bind GalgamePageNewLayout_ShowBackground, Mode=TwoWay}"
                                      HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- 单独选项：显示封面图 -->
                    <Grid ColumnSpacing="12" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   x:Uid="ManageGalgamePageLayoutDialog_ShowCover"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"/>
                        <ToggleSwitch Grid.Column="1"
                                      x:Name="GalgamePageNewLayout_ShowCoverToggle"
                                      IsOn="{x:Bind GalgamePageNewLayout_ShowCover, Mode=TwoWay}"
                                      HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- 单独选项：在没有背景图时显示封面图 -->
                    <Grid ColumnSpacing="12" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0"
                                  x:Uid="ManageGalgamePageLayoutDialog_ShowCoverWhenNoBackground"
                                  IsChecked="{x:Bind GalgamePageNewLayout_ShowCoverWhenNoBackground, Mode=TwoWay}"
                                  IsEnabled="{x:Bind GalgamePageNewLayout_ShowCoverToggle.IsOn, Mode=OneWay}"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left"/>
                    </Grid>

                    <!-- 单独选项：显示预计游玩时长 -->
                    <Grid ColumnSpacing="12" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   x:Uid="ManageGalgamePageLayoutDialog_ShowPlayTime"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"/>
                        <ToggleSwitch Grid.Column="1"
                                      IsOn="{x:Bind GalgamePageNewLayout_ShowExpectedPlayTime, Mode=TwoWay}"
                                      HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- 单独选项：显示游戏评分 -->
                    <Grid ColumnSpacing="12" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   x:Uid="ManageGalgamePageLayoutDialog_ShowRating"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"/>
                        <ToggleSwitch Grid.Column="1"
                                      IsOn="{x:Bind GalgamePageNewLayout_ShowRating, Mode=TwoWay}"
                                      HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- 单独选项：显示游戏tag -->
                    <Grid ColumnSpacing="12" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   x:Uid="ManageGalgamePageLayoutDialog_ShowTags"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"/>
                        <ToggleSwitch Grid.Column="1"
                                      x:Name="GalgamePageNewLayout_ShowTagsToggle"
                                      IsOn="{x:Bind GalgamePageNewLayout_ShowTags, Mode=TwoWay}"
                                      HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- 单独选项：显示游戏角色 -->
                    <Grid ColumnSpacing="12" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   x:Uid="ManageGalgamePageLayoutDialog_ShowCharacters"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"/>
                        <ToggleSwitch Grid.Column="1"
                                      IsOn="{x:Bind GalgamePageNewLayout_ShowCharacters, Mode=TwoWay}"
                                      HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </ListView.Items>
        </ListView>
    </StackPanel>
</ContentDialog>
