<?xml version="1.0" encoding="utf-8"?>

<ContentDialog
    x:Class="GalgameManager.Views.Dialog.StorePluginDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:GalgameManager.Models"
    xmlns:converter="using:GalgameManager.Helpers.Converter"
    DefaultButton="Primary"
    Style="{ThemeResource DefaultContentDialogStyle}"
    mc:Ignorable="d">
    
    <ContentDialog.Resources>
        <converter:DateTimeToStringConverter x:Key="DateToStr"/>
    </ContentDialog.Resources>

    <Grid MaxHeight="200" Width="500">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="8*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="4*"/>
        </Grid.ColumnDefinitions>
        
        <StackPanel Grid.Column="0">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="{x:Bind _storePlugin.ReleaseDate, Converter={StaticResource DateToStr}}"
                           Style="{StaticResource DescriptionTextStyle}"
                           VerticalAlignment="Center" Margin="0 0 5 0"/>
                <HyperlinkButton x:Name="DeveloperLink" Padding="5 0"/>
                <HyperlinkButton x:Name="ProjectLink" x:Uid="StorePluginDialog_ProjectLink" Padding="5 0"/>
            </StackPanel>
            
            <TextBlock Text="{x:Bind _storePlugin.DescriptionDetailed}" TextWrapping="Wrap"
                       Margin="{StaticResource XSmallTopMargin}"/>
        </StackPanel>
        
        <Rectangle Grid.Column="1" Width="1" Margin="10 20"
                   Fill="{ThemeResource SystemControlForegroundBaseLowBrush}"
                   VerticalAlignment="Stretch" />
        
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" x:Uid="StorePluginDialog_PluginVersion" 
                       FontWeight="SemiBold" Margin="15 0 0 0"/>
            <ListView Grid.Row="1" x:Name="VersionsView" ItemsSource="{x:Bind _storePlugin.Versions}"
                      Margin="{StaticResource XSmallTopMargin}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:StorePluginVersion">
                        <StackPanel Margin="0 2.5 20 2.5">
                            <TextBlock Text="{x:Bind Version}"/>
                            <TextBlock Text="{x:Bind ReleaseDate, Converter={StaticResource DateToStr}}"
                                       Style="{StaticResource DescriptionTextStyle}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</ContentDialog>
