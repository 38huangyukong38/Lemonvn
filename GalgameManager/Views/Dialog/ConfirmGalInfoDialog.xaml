<?xml version="1.0" encoding="utf-8"?>

<ContentDialog
    x:Class="GalgameManager.Views.Dialog.ConfirmGalInfoDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converter="using:GalgameManager.Helpers.Converter"
    mc:Ignorable="d"
    Style="{ThemeResource DefaultContentDialogStyle}"
    MinWidth="600">

    <ContentDialog.Resources>
        <converter:ImagePathConverter x:Key="ImagePathConverter"/>
    </ContentDialog.Resources>

    <Grid>
        <Grid MaxWidth="490" MinWidth="490">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- 游戏名称和信息源 -->
                <Grid Grid.Row="0" Margin="0 0 0 10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               x:Uid="ConfirmGalInfoDialog_GalgameName"
                               VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1"
                             VerticalAlignment="Center"
                             Margin="10 0 10 0"
                             Text="{x:Bind Galgame.Name.Value, Mode=TwoWay}"/>
                    <Button Grid.Column="2"
                            Width="32"
                            Height="32"
                            Padding="0"
                            VerticalAlignment="Center"
                            Command="{x:Bind FetchInfoCommand}">
                        <SymbolIcon Symbol="Find"/>
                    </Button>
                </Grid>
                
                <!-- 游戏图片和基本信息 -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.Column="0"
                               Height="135"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Width="97">
                        <Rectangle.Fill>
                            <ImageBrush
                                ImageSource="{x:Bind Galgame.ImagePath.Value, Mode=OneWay, 
                                Converter={StaticResource ImagePathConverter}, FallbackValue={x:Null}}"
                                Stretch="UniformToFill"/>
                        </Rectangle.Fill>
                    </Rectangle>
                    <StackPanel Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                Margin="15 0 0 0"
                                Spacing="5">
                        <!-- 游戏ID -->
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       x:Uid="ConfirmGalInfoDialog_GalgameRssType"
                                       VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1"
                                ItemsSource="{x:Bind RssTypes}"
                                SelectedItem="{x:Bind SelectedRssType, Mode=TwoWay}"
                                MinWidth="120"
                                VerticalAlignment="Center"
                                Margin="10 0 10 0"/>
                            <TextBlock Grid.Column="2"
                                       x:Uid="ConfirmGalInfoDialog_GalgameId"
                                       VerticalAlignment="Center"
                                       Margin="0 0 10 0"/>
                            <TextBox
                                Grid.Column="3"
                                Text="{x:Bind Id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Stretch"
                                Margin="0 0 10 0"
                                AcceptsReturn="False"/>
                            
                        </Grid>

                        <TextBlock Text="{x:Bind Galgame.Description.Value, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   MaxHeight="100"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ID提示 -->
            <TextBlock Grid.Row="1"
                       Margin="{ThemeResource SmallTopMargin}"
                       TextWrapping="Wrap"
                       Style="{ThemeResource DescriptionTextStyle}">
                <Run Text="{x:Bind Hint, Mode=OneWay}" />
            </TextBlock>
        </Grid>


        <Grid
            Row="0"
            Background="{ThemeResource SystemControlBackgroundAltMediumLowBrush}"
            Visibility="{x:Bind IsPhrasing, Mode=OneWay}">
            <ProgressRing
                IsActive="True"
                Width="100"
                Height="100"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</ContentDialog>