<Page x:Class="LemonVN.Views.LemonHomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="using:LemonVN.ViewModels" xmlns:views="using:LemonVN.Views.Anime">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" AutomationProperties.AutomationId="AnimeHomeScroll">
        <StackPanel Padding="8,12,8,16" Spacing="12">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind ViewModel.LibrarySummary, Mode=OneWay}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ProgressRing Grid.Column="1" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="22" Height="22" />
                <Button Grid.Column="2" x:Uid="Browse_All" Command="{x:Bind ViewModel.OpenAllCommand}" AutomationProperties.AutomationId="HomeAllAnime" />
            </Grid>
            <InfoBar IsOpen="{x:Bind ViewModel.IsErrorOpen, Mode=TwoWay}" Visibility="{x:Bind ViewModel.IsErrorOpen, Mode=OneWay}" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Severity="Error" />
            <views:AnimeShelfControl Section="{x:Bind ViewModel.Recent, Mode=OneWay}" AutomationProperties.AutomationId="HomeRecentShelf" />
            <StackPanel Spacing="8">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Uid="Browse_StudiosTitle" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button x:Uid="Browse_More" Command="{x:Bind ViewModel.BrowseStudiosCommand}" AutomationProperties.AutomationId="HomeBrowseStudios" />
                        <views:HorizontalPager Target="{x:Bind StudioList}" ItemStride="202" />
                    </StackPanel>
                </Grid>
                <TextBlock x:Uid="Browse_StudioHint" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Uid="Browse_NoStudioGroups" Visibility="{x:Bind ViewModel.NoStudios, Mode=OneWay}" TextWrapping="Wrap" />
                <ListView x:Name="StudioList" Height="92" ItemsSource="{x:Bind ViewModel.Studios, Mode=OneWay}" SelectionMode="None"
                          ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          Visibility="{x:Bind ViewModel.HasStudios, Mode=OneWay}" AutomationProperties.AutomationId="HomeStudioGroups">
                    <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListView.ItemsPanel>
                    <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,12,0" /><Setter Property="VerticalAlignment" Value="Top" /></Style></ListView.ItemContainerStyle>
                    <ListView.ItemTemplate><DataTemplate x:DataType="vm:AnimeGroupViewModel">
                        <Button Command="{x:Bind OpenCommand}" Width="190" Height="76" Padding="10" ToolTipService.ToolTip="{x:Bind Title}">
                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE731;" FontSize="24" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{x:Bind Title}" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" /><TextBlock Text="{x:Bind CountText}" Style="{ThemeResource CaptionTextBlockStyle}" /></StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate></ListView.ItemTemplate>
                </ListView>
            </StackPanel>
            <views:AnimeShelfControl Section="{x:Bind ViewModel.Watching, Mode=OneWay}" AutomationProperties.AutomationId="HomeWatchingShelf" />
            <views:AnimeShelfControl Section="{x:Bind ViewModel.Completed, Mode=OneWay}" AutomationProperties.AutomationId="HomeCompletedShelf" />
            <views:AnimeShelfControl Section="{x:Bind ViewModel.Planned, Mode=OneWay}" AutomationProperties.AutomationId="HomePlannedShelf" />
        </StackPanel>
    </ScrollViewer>
</Page>
