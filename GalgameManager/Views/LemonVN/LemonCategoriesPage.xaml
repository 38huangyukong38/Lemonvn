<Page x:Class="LemonVN.Views.LemonCategoriesPage" NavigationCacheMode="Enabled"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:LemonVN.ViewModels">
    <Page.Resources>
        <DataTemplate x:Key="CategoryTile" x:DataType="vm:AnimeGroupViewModel">
            <Button Command="{x:Bind OpenCommand}" Width="168" Height="116" Padding="8" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{x:Bind Title}" ToolTipService.ToolTip="{x:Bind Title}">
                <StackPanel Spacing="5">
                    <Border Width="40" Height="40" CornerRadius="20" HorizontalAlignment="Center" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                        <FontIcon Glyph="&#xE8EC;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </Border>
                    <TextBlock Text="{x:Bind Title}" FontSize="14" FontWeight="SemiBold" MaxLines="1" TextTrimming="CharacterEllipsis" TextAlignment="Center" />
                    <TextBlock Text="{x:Bind CountText}" FontSize="12" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </Page.Resources>
    <Grid Padding="8,12,8,8" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="22" Height="22" HorizontalAlignment="Left" />
            <Button Grid.Column="1" x:Uid="Browse_All" Command="{x:Bind ViewModel.OpenAllCommand}" />
        </Grid>
        <InfoBar Grid.Row="1" IsOpen="{x:Bind ViewModel.IsErrorOpen, Mode=TwoWay}" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Severity="Error" />
        <Pivot Grid.Row="2" SelectedIndex="{x:Bind ViewModel.Mode, Mode=TwoWay}" AutomationProperties.AutomationId="AnimeCategoryTabs">
            <PivotItem x:Uid="Browse_StatusTab">
                <GridView ItemsSource="{x:Bind ViewModel.StatusGroups, Mode=OneWay}" SelectionMode="None" ItemTemplate="{StaticResource CategoryTile}" AutomationProperties.AutomationId="AnimeStatusGroups" />
            </PivotItem>
            <PivotItem x:Uid="Browse_StudioTab">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
                    <TextBlock x:Uid="Browse_StudioHint" Margin="4,4,4,16" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <GridView Grid.Row="1" ItemsSource="{x:Bind ViewModel.StudioGroups, Mode=OneWay}" SelectionMode="None" ItemTemplate="{StaticResource CategoryTile}" AutomationProperties.AutomationId="AnimeStudioGroups" />
                    <TextBlock Grid.Row="1" x:Uid="Browse_NoStudioGroups" Visibility="{x:Bind ViewModel.NoStudios, Mode=OneWay}" Margin="8,20" TextWrapping="Wrap" />
                </Grid>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
