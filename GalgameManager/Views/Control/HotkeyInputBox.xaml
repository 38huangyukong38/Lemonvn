<UserControl
    x:Class="GalgameManager.Views.Control.HotkeyInputBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border Background="{ThemeResource TextControlBackground}"
            BorderBrush="{ThemeResource TextControlBorderBrush}"
            BorderThickness="{ThemeResource TextControlBorderThemeThickness}"
            CornerRadius="{ThemeResource ControlCornerRadius}"
            MinHeight="32"
            Padding="11,5,11,6">
        <Grid>
            <TextBlock x:Name="PlaceholderTextBlock"
                       Text="{x:Bind PlaceholderText, Mode=OneWay}"
                       Foreground="{ThemeResource TextControlPlaceholderForeground}"
                       Visibility="{x:Bind ShowPlaceholder, Mode=OneWay}"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False" />
                       
            <TextBlock x:Name="HotkeyDisplayTextBlock"
                       Text="{x:Bind HotkeyDisplayText, Mode=OneWay}"
                       Foreground="{ThemeResource TextControlForeground}"
                       Visibility="{x:Bind HideText, Mode=OneWay}"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False" />
                       
            <Button x:Name="InputButton"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    VerticalContentAlignment="Center"
                    Padding="0"
                    Click="InputButton_Click"
                    KeyDown="InputButton_KeyDown"
                    LostFocus="InputButton_LostFocus"
                    Content="{x:Bind ButtonText, Mode=OneWay}" />
        </Grid>
    </Border>
</UserControl> 