<Page x:Class="LemonVN.Views.Anime.AnimeEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:images="using:LemonVN.Views.Anime">
    <Grid RowSpacing="12" Padding="8,12,8,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="12">
            <Button x:Uid="AnimeEditor_Save" Command="{x:Bind ViewModel.SaveCommand}" AutomationProperties.AutomationId="AnimeSave" />
            <Button x:Uid="AnimeEditor_Cancel" Command="{x:Bind ViewModel.CancelCommand}" AutomationProperties.AutomationId="AnimeCancel" />
            <Button x:Uid="Bangumi_SearchEntry" Command="{x:Bind ViewModel.SearchBangumiCommand}" Visibility="{x:Bind ViewModel.CanSearchBangumi, Mode=OneWay}" AutomationProperties.AutomationId="AnimeEditorBangumi" />
            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="24" Height="24" />
        </StackPanel>
        <InfoBar Grid.Row="1" IsOpen="{x:Bind ViewModel.IsErrorOpen, Mode=TwoWay}" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Severity="Error" />
        <ScrollViewer Grid.Row="2">
            <Grid ColumnSpacing="24" RowSpacing="16" MaxWidth="1100" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <StackPanel Spacing="12">
                    <Image images:LocalCoverImage.Source="{x:Bind ViewModel.CurrentCoverSource, Mode=OneWay}" Height="240" Stretch="UniformToFill" />
                    <Button x:Uid="AnimeEditor_PickCover" Command="{x:Bind ViewModel.PickCoverCommand}" AutomationProperties.AutomationId="AnimePickCover" />
                    <TextBox x:Uid="AnimeEditor_CoverPath" Text="{x:Bind ViewModel.CoverSourcePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap" AutomationProperties.AutomationId="AnimeCoverPath" />
                    <CheckBox x:Uid="AnimeEditor_RemoveCover" IsChecked="{x:Bind ViewModel.RemoveCover, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="16">
                    <TextBlock Text="{x:Bind ViewModel.Heading, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Uid="Bangumi_EditProtection" TextWrapping="Wrap" />
                    <TextBox x:Uid="AnimeEditor_Title" Text="{x:Bind ViewModel.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.AutomationId="AnimeTitleInput" />
                    <TextBox x:Uid="AnimeEditor_OriginalTitle" Text="{x:Bind ViewModel.OriginalTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.AutomationId="AnimeOriginalTitleInput" />
                    <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBox x:Uid="AnimeEditor_Episodes" Text="{x:Bind ViewModel.TotalEpisodesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.AutomationId="AnimeEpisodesInput" />
                        <TextBox Grid.Column="1" x:Uid="AnimeEditor_AirDate" Text="{x:Bind ViewModel.AirDateText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.AutomationId="AnimeAirDateInput" />
                    </Grid>
                    <TextBox x:Uid="AnimeEditor_Description" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" MaxHeight="180"
                             Text="{x:Bind ViewModel.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="AnimeDescriptionInput" />
                    <TextBox x:Uid="Browse_StudiosEditor" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="144"
                             Text="{x:Bind ViewModel.AnimationStudiosText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="AnimeStudiosInput" />
                    <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <ComboBox x:Uid="AnimeEditor_Status" SelectedIndex="{x:Bind ViewModel.StatusIndex, Mode=TwoWay}" HorizontalAlignment="Stretch"
                                  AutomationProperties.AutomationId="AnimeStatusInput">
                            <ComboBoxItem x:Uid="AnimeStatus_Planned" /><ComboBoxItem x:Uid="AnimeStatus_Watching" />
                            <ComboBoxItem x:Uid="AnimeStatus_Completed" /><ComboBoxItem x:Uid="AnimeStatus_OnHold" /><ComboBoxItem x:Uid="AnimeStatus_Dropped" />
                        </ComboBox>
                        <TextBox Grid.Column="1" x:Uid="AnimeEditor_Rating" Text="{x:Bind ViewModel.RatingText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.AutomationId="AnimeRatingInput" />
                    </Grid>
                    <TextBox x:Uid="AnimeEditor_Notes" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" MaxHeight="160"
                             Text="{x:Bind ViewModel.Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="AnimeNotesInput" />
                    <TextBox x:Uid="AnimeEditor_Tags" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="128"
                             Text="{x:Bind ViewModel.TagsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="AnimeTagsInput" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
