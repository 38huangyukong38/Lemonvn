<Page x:Class="LemonVN.Views.Anime.AnimeDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:control="using:GalgameManager.Views.Control"
      xmlns:anime="using:LemonVN.ViewModels.Anime"
      xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
    <ScrollViewer>
        <StackPanel Spacing="20" Padding="8,16,8,24">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Uid="AnimeDetail_Library" Command="{x:Bind ViewModel.LibraryCommand}" AutomationProperties.AutomationId="AnimeBackToLibrary" />
                <Button x:Uid="AnimeDetail_Edit" Command="{x:Bind ViewModel.EditCommand}" IsEnabled="{x:Bind ViewModel.Progress.CanInteract, Mode=OneWay}" AutomationProperties.AutomationId="AnimeEdit" />
                <Button x:Uid="AnimeDetail_Delete" Command="{x:Bind ViewModel.DeleteCommand}" IsEnabled="{x:Bind ViewModel.Progress.CanInteract, Mode=OneWay}" AutomationProperties.AutomationId="AnimeDelete" />
                <Button x:Uid="Bangumi_Link" Command="{x:Bind ViewModel.LinkBangumiCommand}" IsEnabled="{x:Bind ViewModel.Progress.CanInteract, Mode=OneWay}" AutomationProperties.AutomationId="AnimeBangumiLink" />
                <Button x:Uid="Bangumi_Refresh" Command="{x:Bind ViewModel.RefreshBangumiCommand}" Visibility="{x:Bind ViewModel.HasBangumiSource, Mode=OneWay}" AutomationProperties.AutomationId="AnimeBangumiRefresh" />
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="24" Height="24" />
            </StackPanel>
            <InfoBar IsOpen="{x:Bind ViewModel.IsErrorOpen, Mode=TwoWay}" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Severity="Error" />
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Image Source="{x:Bind ViewModel.CoverSource, Mode=OneWay}" Width="180" Height="252" Stretch="UniformToFill"
                       VerticalAlignment="Top" ImageFailed="OnCoverFailed" />
                <StackPanel Grid.Column="1" Spacing="12">
                    <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" TextWrapping="Wrap" Style="{ThemeResource TitleTextBlockStyle}"
                               AutomationProperties.AutomationId="AnimeDetailTitle" />
                    <TextBlock Text="{x:Bind ViewModel.OriginalTitle, Mode=OneWay}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.BangumiSource, Mode=OneWay}" />
                    <TextBlock x:Uid="AnimeDetail_Episodes" /><TextBlock Text="{x:Bind ViewModel.Episodes, Mode=OneWay}" />
                    <TextBlock x:Uid="AnimeDetail_AirDate" /><TextBlock Text="{x:Bind ViewModel.AirDate, Mode=OneWay}" />
                    <TextBlock x:Uid="Browse_StudiosTitle" /><TextBlock Text="{x:Bind ViewModel.AnimationStudios, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="AnimeDetailStudios" />
                </StackPanel>
            </Grid>
            <control:Panel><StackPanel Spacing="8">
                <TextBlock x:Uid="AnimeDetail_Description" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.Description, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </StackPanel></control:Panel>
            <control:Panel><StackPanel Spacing="12">
                <TextBlock x:Uid="AnimeDetail_MyRecord" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <TextBlock x:Uid="AnimeDetail_Rating" /><TextBlock Text="{x:Bind ViewModel.Rating, Mode=OneWay}" />
                <TextBlock x:Uid="AnimeDetail_Tags" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Tags, Mode=OneWay}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><toolkit:WrapPanel HorizontalSpacing="8" VerticalSpacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="10,4"><TextBlock Text="{x:Bind}" /></Border></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Uid="AnimeDetail_Notes" />
                <TextBlock Text="{x:Bind ViewModel.Notes, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </StackPanel></control:Panel>
            <control:Panel>
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="AnimeProgress_Title" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.Progress.Summary, Mode=OneWay}" AutomationProperties.AutomationId="AnimeProgressSummary" />
                    <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind ViewModel.Progress.Percentage, Mode=OneWay}"
                                 Visibility="{x:Bind ViewModel.Progress.HasKnownTotal, Mode=OneWay}" AutomationProperties.AutomationId="AnimeProgressBar" />
                    <InfoBar IsOpen="{x:Bind ViewModel.Progress.HasOutOfRange, Mode=OneWay}" IsClosable="False" Severity="Warning"
                             Message="{x:Bind ViewModel.Progress.OutOfRangeMessage, Mode=OneWay}" />
                    <InfoBar IsOpen="{x:Bind ViewModel.Progress.IsErrorOpen, Mode=TwoWay}" Severity="Error"
                             Message="{x:Bind ViewModel.Progress.ErrorMessage, Mode=OneWay}" />
                    <ContentControl IsEnabled="{x:Bind ViewModel.Progress.CanInteract, Mode=OneWay}" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Uid="AnimeProgress_Next" Command="{x:Bind ViewModel.Progress.MarkNextCommand}"
                                    IsEnabled="{x:Bind ViewModel.Progress.CanMarkNext, Mode=OneWay}" AutomationProperties.AutomationId="AnimeProgressNext" />
                            <Button Content="{x:Bind ViewModel.Progress.UndoLabel, Mode=OneWay}" Command="{x:Bind ViewModel.Progress.UndoHighestCommand}"
                                    IsEnabled="{x:Bind ViewModel.Progress.CanUndo, Mode=OneWay}" AutomationProperties.AutomationId="AnimeProgressUndo" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBox x:Uid="AnimeProgress_ThroughInput" Width="190" Text="{x:Bind ViewModel.Progress.ThroughText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="AnimeProgressThroughInput" />
                            <Button x:Uid="AnimeProgress_Through" Command="{x:Bind ViewModel.Progress.MarkThroughCommand}"
                                    VerticalAlignment="Bottom" AutomationProperties.AutomationId="AnimeProgressThrough" />
                        </StackPanel>
                        <TextBlock x:Uid="AnimeProgress_ThroughHint" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" />
                        <Expander x:Uid="AnimeProgress_Expand" IsExpanded="{x:Bind ViewModel.Progress.IsExpanded, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="AnimeEpisodeExpander">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Uid="AnimeProgress_PreviousPage" Command="{x:Bind ViewModel.Progress.PreviousPageCommand}"
                                            IsEnabled="{x:Bind ViewModel.Progress.CanPreviousPage, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind ViewModel.Progress.PageRange, Mode=OneWay}" VerticalAlignment="Center" />
                                    <Button x:Uid="AnimeProgress_NextPage" Command="{x:Bind ViewModel.Progress.NextPageCommand}"
                                            IsEnabled="{x:Bind ViewModel.Progress.CanNextPage, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox x:Uid="AnimeProgress_PageInput" Width="190" Text="{x:Bind ViewModel.Progress.PageStartText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button x:Uid="AnimeProgress_JumpPage" Command="{x:Bind ViewModel.Progress.JumpPageCommand}" VerticalAlignment="Bottom" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Progress.EpisodeItems}" AutomationProperties.AutomationId="AnimeEpisodeList">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate>
                                        <toolkit:WrapPanel HorizontalSpacing="8" VerticalSpacing="8" />
                                    </ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate x:DataType="anime:EpisodeProgressItem">
                                        <Button Command="{x:Bind ToggleCommand}" CommandParameter="{x:Bind EpisodeNumber}" Padding="12,8" AutomationProperties.Name="{x:Bind Label}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <SymbolIcon Symbol="Accept" Visibility="{x:Bind IsWatched}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                <TextBlock Text="{x:Bind Label}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                    </ContentControl>
                    <ProgressRing IsActive="{x:Bind ViewModel.Progress.IsBusy, Mode=OneWay}" Width="24" Height="24" HorizontalAlignment="Left" />
                </StackPanel>
            </control:Panel>
        </StackPanel>
    </ScrollViewer>
</Page>
