<Page x:Class="LemonVN.Views.Anime.AnimeLibraryPage" NavigationCacheMode="Enabled"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:anime="using:LemonVN.ViewModels.Anime"
      xmlns:views="using:LemonVN.Views.Anime"
      xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
    <Grid RowSpacing="8" Padding="8,12,8,8">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind ViewModel.LibraryTitle}" Style="{ThemeResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <CommandBar Grid.Column="1" Background="Transparent" IsOpen="False" DefaultLabelPosition="Right"
                        HorizontalContentAlignment="Right" IsDynamicOverflowEnabled="True" ClosedDisplayMode="Compact"
                        AutomationProperties.AutomationId="AnimeToolbar">
                <AppBarButton x:Uid="Ux_Search" Icon="Find" AutomationProperties.AutomationId="AnimeSearchButton">
                    <AppBarButton.Flyout><Flyout Placement="Bottom"><StackPanel Width="280" Spacing="10">
                        <TextBox x:Uid="AnimeLibrary_Search" Text="{x:Bind ViewModel.Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="AnimeSearch" />
                        <Button x:Uid="Ux_ClearSearch" Command="{x:Bind ViewModel.ClearSearchCommand}" />
                    </StackPanel></Flyout></AppBarButton.Flyout>
                    <AppBarButton.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control" Key="F" /></AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton x:Uid="Ux_Filter" Icon="Filter" AutomationProperties.AutomationId="AnimeFilterButton">
                    <AppBarButton.Flyout><Flyout Placement="Bottom"><StackPanel Width="260" Spacing="12">
                        <ComboBox HorizontalAlignment="Stretch" x:Uid="AnimeLibrary_Status" SelectedIndex="{x:Bind ViewModel.StatusIndex, Mode=TwoWay}" AutomationProperties.AutomationId="AnimeStatusFilter">
                            <ComboBoxItem x:Uid="AnimeFilter_All" /><ComboBoxItem x:Uid="AnimeStatus_Planned" /><ComboBoxItem x:Uid="AnimeStatus_Watching" />
                            <ComboBoxItem x:Uid="AnimeStatus_Completed" /><ComboBoxItem x:Uid="AnimeStatus_OnHold" /><ComboBoxItem x:Uid="AnimeStatus_Dropped" />
                        </ComboBox>
                        <ComboBox HorizontalAlignment="Stretch" x:Uid="AnimeLibrary_Tags" ItemsSource="{x:Bind ViewModel.AvailableTags, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedTag, Mode=TwoWay}" AutomationProperties.AutomationId="AnimeTagFilter" />
                        <Button x:Uid="Ux_ClearTag" Command="{x:Bind ViewModel.ClearTagCommand}" />
                        <Button x:Uid="AnimeLibrary_ClearFilters" Command="{x:Bind ViewModel.ClearFiltersCommand}" />
                    </StackPanel></Flyout></AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton x:Uid="Ux_Add" Icon="Add" AutomationProperties.AutomationId="AnimeAddButton">
                    <AppBarButton.Flyout><MenuFlyout>
                        <MenuFlyoutItem x:Uid="Ux_AddManual" Command="{x:Bind ViewModel.AddAnimeCommand}" AutomationProperties.AutomationId="AnimeAdd" />
                        <MenuFlyoutItem x:Uid="Ux_AddBangumi" Command="{x:Bind ViewModel.SearchBangumiCommand}" AutomationProperties.AutomationId="AnimeBangumiSearch" />
                    </MenuFlyout></AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton x:Uid="Ux_Sort" Icon="Sort" AutomationProperties.AutomationId="AnimeSortButton">
                    <AppBarButton.Flyout><MenuFlyout Opening="OnSortMenuOpening" /></AppBarButton.Flyout>
                </AppBarButton>
                <CommandBar.SecondaryCommands>
                    <AppBarButton x:Uid="Ux_Refresh" Icon="Refresh" Command="{x:Bind ViewModel.LoadCommand}" />
                    <AppBarButton x:Uid="Ux_Recycle" Icon="Delete" Command="{x:Bind ViewModel.OpenRecycleCommand}" AutomationProperties.AutomationId="AnimeRecycle" />
                    <AppBarButton x:Uid="Ux_Undo" Icon="Undo" Command="{x:Bind ViewModel.UndoDeleteCommand}" Visibility="{x:Bind ViewModel.CanUndoDelete, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanUndoDelete, Mode=OneWay}" AutomationProperties.AutomationId="AnimeUndoDelete" />
                </CommandBar.SecondaryCommands>
            </CommandBar>
        </Grid>
        <toolkit:WrapPanel Grid.Row="1" HorizontalSpacing="12" VerticalSpacing="4" Margin="8,0,8,4">
            <TextBlock Text="{x:Bind ViewModel.ResultSummary, Mode=OneWay}" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" />
            <TextBlock Text="{x:Bind ViewModel.SortSummary, Mode=OneWay}" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="{x:Bind ViewModel.FilterSummary, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasFilters, Mode=OneWay}" MaxWidth="400" MaxLines="1" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ViewModel.FilterSummary, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            <HyperlinkButton x:Uid="AnimeLibrary_ClearFilters" Command="{x:Bind ViewModel.ClearFiltersCommand}" Visibility="{x:Bind ViewModel.HasFilters, Mode=OneWay}" Padding="0" AutomationProperties.AutomationId="AnimeClearFilters" />
            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="20" Height="20" />
        </toolkit:WrapPanel>
        <StackPanel Grid.Row="2" Spacing="8">
            <InfoBar IsOpen="{x:Bind ViewModel.IsErrorOpen, Mode=TwoWay}" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Severity="Error" />
            <InfoBar IsOpen="{x:Bind ViewModel.HasTransferMessage, Mode=TwoWay}" Message="{x:Bind ViewModel.TransferMessage, Mode=OneWay}" Severity="Success" />
        </StackPanel>
        <GridView x:Name="AnimeGrid" Grid.Row="3" ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                  IsItemClickEnabled="True" SelectionMode="Single" ItemClick="OnAnimeClicked" AutomationProperties.AutomationId="AnimeLibrary">
            <GridView.ItemContainerStyle><Style TargetType="GridViewItem">
                <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,12,12" />
                <Setter Property="MinHeight" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="ContextFlyout"><Setter.Value><MenuFlyout Opening="OnCardMenuOpening" /></Setter.Value></Setter>
            </Style></GridView.ItemContainerStyle>
            <GridView.ItemTemplate><DataTemplate x:DataType="anime:AnimeCardViewModel">
                <views:AnimeCardControl Card="{x:Bind}" />
            </DataTemplate></GridView.ItemTemplate>
        </GridView>
        <StackPanel Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Visibility="{x:Bind ViewModel.IsLibraryEmpty, Mode=OneWay}">
            <FontIcon Glyph="&#xE8F1;" FontSize="44" />
            <TextBlock x:Uid="AnimeLibrary_Empty" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <TextBlock x:Uid="AnimeLibrary_EmptyDescription" TextWrapping="Wrap" />
            <Button x:Uid="AnimeLibrary_Add" Command="{x:Bind ViewModel.AddAnimeCommand}" HorizontalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Visibility="{x:Bind ViewModel.HasNoMatches, Mode=OneWay}">
            <TextBlock x:Uid="AnimeLibrary_NoMatches" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <Button x:Uid="AnimeLibrary_ClearFilters" Command="{x:Bind ViewModel.ClearFiltersCommand}" />
        </StackPanel>
    </Grid>
</Page>
