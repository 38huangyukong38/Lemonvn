<UserControl x:Class="LemonVN.Views.Anime.AnimeCardControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:images="using:LemonVN.Views.Anime" Width="190">
    <Grid x:Name="CardLayout" Padding="8,8,8,3" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="CoverRow" Height="244" /><RowDefinition x:Name="TitleRow" Height="*" MinHeight="42" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border CornerRadius="10">
            <Image Stretch="UniformToFill" images:LocalCoverImage.Source="{x:Bind Card.CoverSource, Mode=OneWay}" />
        </Border>
        <TextBlock x:Name="CardTitle" Grid.Row="1" Margin="0,6,0,0" Text="{x:Bind Card.Title, Mode=OneWay}" MaxLines="2" LineHeight="18" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Card.Title, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
        <Grid x:Name="PersonalInfo" Grid.Row="2" Margin="0,4,0,0" ColumnSpacing="6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind Card.Status, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" />
            <TextBlock Grid.Column="1" Text="{x:Bind Card.TagsText, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Card.TagsText, Mode=OneWay}" FontSize="11" MaxLines="1" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Column="2" Text="{x:Bind Card.RatingText, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" />
        </Grid>
        <TextBlock Grid.Row="3" Margin="{x:Bind ProgressTextMargin(Card.HasKnownTotal), Mode=OneWay}" Text="{x:Bind ProgressLabel(Card, IsCompact), Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ProgressLabel(Card, IsCompact), Mode=OneWay}" FontSize="11" MaxLines="1" TextTrimming="CharacterEllipsis" />
        <ProgressBar Grid.Row="4" Margin="0,3,0,0" Value="{x:Bind Card.Percentage, Mode=OneWay}" Maximum="100" Height="3" Visibility="{x:Bind Card.HasKnownTotal, Mode=OneWay}" />
    </Grid>
</UserControl>
