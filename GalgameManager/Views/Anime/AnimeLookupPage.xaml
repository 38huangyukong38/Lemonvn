<Page x:Class="LemonVN.Views.Anime.AnimeLookupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:anime="using:LemonVN.ViewModels.Anime"
      xmlns:control="using:GalgameManager.Views.Control"
      xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
    <Grid Padding="8,16" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
        <StackPanel Spacing="10">
            <TextBlock x:Uid="Bangumi_PublicOnly" TextWrapping="Wrap" />
            <toolkit:WrapPanel HorizontalSpacing="12" VerticalSpacing="8">
                <TextBox x:Uid="Bangumi_Keyword" Width="360" Text="{x:Bind ViewModel.Keyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{x:Bind ViewModel.ShowSearch, Mode=OneWay}" KeyDown="OnKeywordKeyDown" TextCompositionStarted="OnKeywordCompositionStarted" TextCompositionEnded="OnKeywordCompositionEnded" AutomationProperties.AutomationId="BangumiKeyword" />
                <Button x:Uid="Bangumi_Search" Command="{x:Bind ViewModel.SearchCommand}" IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}" Visibility="{x:Bind ViewModel.ShowSearch, Mode=OneWay}" AutomationProperties.AutomationId="BangumiSearch" />
                <Button x:Uid="Bangumi_Retry" Command="{x:Bind ViewModel.RetryCommand}" IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}" />
                <Button x:Uid="AnimeEditor_Cancel" Command="{x:Bind ViewModel.CancelCommand}" IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                <Button x:Uid="Bangumi_Manual" Command="{x:Bind ViewModel.ManualCommand}" AutomationProperties.AutomationId="BangumiManual" />
                <ProgressRing Width="24" Height="24" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            </toolkit:WrapPanel>
        </StackPanel>
        <StackPanel Grid.Row="1" Spacing="8">
            <InfoBar IsOpen="{x:Bind ViewModel.IsErrorOpen, Mode=TwoWay}" Message="{x:Bind ViewModel.Message, Mode=OneWay}" Severity="Error" />
            <Button x:Uid="Bangumi_OpenExisting" Command="{x:Bind ViewModel.OpenExistingCommand}" Visibility="{x:Bind ViewModel.HasDuplicate, Mode=OneWay}" AutomationProperties.AutomationId="BangumiOpenExisting" />
            <InfoBar IsOpen="{x:Bind ViewModel.IsNoticeOpen, Mode=TwoWay}" Message="{x:Bind ViewModel.Notice, Mode=OneWay}" Severity="Warning" />
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" Visibility="{x:Bind ViewModel.ShowSearch, Mode=OneWay}">
            <Button x:Uid="Bangumi_Previous" Command="{x:Bind ViewModel.PreviousCommand}" IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}" />
            <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" VerticalAlignment="Center" />
            <Button x:Uid="Bangumi_Next" Command="{x:Bind ViewModel.NextCommand}" IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}" />
        </StackPanel>
        <Grid Grid.Row="3" ColumnSpacing="20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="360" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <ListView ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}" IsItemClickEnabled="True" ItemClick="OnResultClicked" SelectionMode="None" AutomationProperties.AutomationId="BangumiResults">
                <ListView.ItemTemplate><DataTemplate x:DataType="anime:BangumiResultItem">
                    <Grid Padding="6,12" ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="84" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Image Width="84" Height="118" Stretch="UniformToFill"><Image.Source><BitmapImage UriSource="{x:Bind Cover, Mode=OneWay}" DecodePixelWidth="200" /></Image.Source></Image>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="{x:Bind Title}" Style="{ThemeResource BodyStrongTextBlockStyle}" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind OriginalTitle}" MaxLines="1" TextTrimming="CharacterEllipsis" FontSize="11" />
                            <TextBlock Text="{x:Bind DateAndId}" FontSize="11" />
                            <TextBlock Text="{x:Bind Summary}" MaxLines="3" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" FontSize="11" />
                        </StackPanel>
                    </Grid>
                </DataTemplate></ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Uid="Bangumi_Empty" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <ScrollViewer Grid.Column="1" Visibility="{x:Bind ViewModel.HasPreview, Mode=OneWay}">
                <StackPanel Spacing="16">
                    <control:Panel><StackPanel Spacing="12">
                        <TextBlock x:Uid="Bangumi_Preview" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <Image Width="150" Height="210" HorizontalAlignment="Left" Stretch="UniformToFill"><Image.Source><BitmapImage UriSource="{x:Bind ViewModel.Cover, Mode=OneWay}" DecodePixelWidth="320" /></Image.Source></Image>
                        <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" TextWrapping="Wrap" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.OriginalTitle, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.SourceId, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.DateAndEpisodes, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.Description, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    </StackPanel></control:Panel>
                    <control:Panel><StackPanel Spacing="12">
                        <TextBlock x:Uid="Bangumi_Differences" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Uid="Bangumi_RecordSafe" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Differences, Mode=OneWay}">
                            <ItemsControl.ItemTemplate><DataTemplate x:DataType="anime:MetadataDiffItem">
                                <StackPanel Spacing="6" Margin="0,8">
                                    <StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{x:Bind Field}" Style="{ThemeResource BodyStrongTextBlockStyle}" /><TextBlock Text="{x:Bind Status}" /></StackPanel>
                                    <TextBlock Text="{x:Bind Local}" MaxLines="3" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Remote}" MaxLines="3" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="{x:Bind ViewModel.ConfirmLabel, Mode=OneWay}" Command="{x:Bind ViewModel.ConfirmCommand}" IsEnabled="{x:Bind ViewModel.CanConfirm, Mode=OneWay}" AutomationProperties.AutomationId="BangumiConfirm" />
                    </StackPanel></control:Panel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
