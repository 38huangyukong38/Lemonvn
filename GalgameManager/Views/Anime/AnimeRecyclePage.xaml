<Page x:Class="LemonVN.Views.Anime.AnimeRecyclePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:anime="using:LemonVN.ViewModels.Anime">
    <Grid RowSpacing="16" Padding="8,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Spacing="12">
            <TextBlock x:Uid="Recycle_Description" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Uid="AnimeLibrary_Refresh" Command="{x:Bind ViewModel.ReloadCommand}" IsEnabled="{x:Bind ViewModel.CanOperate, Mode=OneWay}" />
                <Button x:Uid="Recycle_Preview" Command="{x:Bind ViewModel.PreviewCoversCommand}" IsEnabled="{x:Bind ViewModel.CanOperate, Mode=OneWay}" />
                <ProgressRing Width="24" Height="24" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>
        <InfoBar Grid.Row="1" IsOpen="{x:Bind ViewModel.IsMessageOpen, Mode=TwoWay}" Message="{x:Bind ViewModel.Message, Mode=OneWay}" />
        <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}" SelectionMode="None" IsEnabled="{x:Bind ViewModel.CanOperate, Mode=OneWay}" AutomationProperties.AutomationId="AnimeRecycleList">
            <ListView.ItemTemplate><DataTemplate x:DataType="anime:AnimeTrashItem">
                <Grid Padding="8,12" ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="6"><TextBlock Text="{x:Bind Title}" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Style="{ThemeResource BodyStrongTextBlockStyle}" /><TextBlock Text="{x:Bind Tags}" /></StackPanel>
                    <Button Grid.Column="1" x:Uid="Recycle_Restore" Command="{x:Bind RestoreCommand}" CommandParameter="{x:Bind}" />
                    <Button Grid.Column="2" x:Uid="Recycle_PurgeButton" Command="{x:Bind PurgeCommand}" CommandParameter="{x:Bind}" />
                </Grid>
            </DataTemplate></ListView.ItemTemplate>
        </ListView>
        <TextBlock Grid.Row="2" x:Uid="Recycle_Empty" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
        <Expander Grid.Row="3" x:Uid="Recycle_PreviewHeading" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <ListView MaxHeight="150" ItemsSource="{x:Bind ViewModel.CoverPreview, Mode=OneWay}" SelectionMode="None" />
        </Expander>
    </Grid>
</Page>
