<Page
    x:Class="GalgameManager.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:control="using:GalgameManager.Views.Control"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:GalgameManager.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:GalgameManager.ViewModels"
    ActualThemeChanged="{x:Bind OnActualThemeChanged}"
    Loaded="OnLoaded"
    mc:Ignorable="d">

    <Page.Resources>
        <x:String x:Key="SidebarButtonDefaultGlyph">&#xE10F;</x:String>
    </Page.Resources>

    <Grid x:Name="RootGrid">
        <Grid.Background>
            <ImageBrush x:Name="CustomBackgroundBrush" Stretch="Uniform" />
        </Grid.Background>
        <Grid
            x:Name="AppTitleBar"
            Height="{Binding ElementName=NavigationViewControl, Path=CompactPaneLength}"
            VerticalAlignment="Top"
            Canvas.ZIndex="1"
            IsHitTestVisible="True">
            <Image
                x:Name="AppTitleBarIcon"
                Width="16"
                Height="16"
                HorizontalAlignment="Left"
                Source="/Assets/WindowIcon.ico" />
            <TextBlock
                x:Name="AppTitleBarText"
                Margin="28,0,0,0"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextWrapping="NoWrap" />
        </Grid>

        <NavigationView
            x:Name="NavigationViewControl"
            Canvas.ZIndex="0"
            DisplayModeChanged="NavigationViewControl_DisplayModeChanged"
            Header="{x:Bind ViewModel.SelectedPageTitle, Mode=OneWay, FallbackValue=''}"
            IsBackButtonVisible="Visible"
            IsBackEnabled="{x:Bind ViewModel.IsBackEnabled, Mode=OneWay}"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            OpenPaneLength="72"
            PaneDisplayMode="Left"
            SelectedItem="{x:Bind ViewModel.Selected, Mode=OneWay}">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="MultiStreamNavItem"
                    Width="70"
                    helpers:NavigationHelper.NavigateTo="GalgameManager.ViewModels.MultiStreamViewModel">
                    <NavigationViewItem.Content>
                        <Grid
                            Width="60"
                            Height="65"
                            Margin="-12,0,-20,0">
                            <FontIcon
                                Margin="0,18,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="16"
                                Glyph="&#xe80f;" />
                            <TextBlock
                                x:Uid="Shell_MultiStreamText"
                                Margin="0,0,0,16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                FontSize="12"
                                TextAlignment="Center"
                                TextWrapping="NoWrap" />
                        </Grid>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <NavigationViewItem
                    x:Name="HomeNavItem"
                    Width="70"
                    helpers:NavigationHelper.NavigateTo="GalgameManager.ViewModels.HomeViewModel">
                    <NavigationViewItem.Content>
                        <Grid
                            Width="60"
                            Height="65"
                            Margin="-12,0,-20,0">
                            <FontIcon
                                Margin="0,18,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="16"
                                Glyph="&#xf0e2;" />
                            <TextBlock
                                x:Uid="Shell_Home_Text"
                                Margin="0,0,0,16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                FontSize="12"
                                TextAlignment="Center"
                                TextWrapping="NoWrap" />
                        </Grid>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <NavigationViewItem
                    x:Name="LibraryNavItem"
                    Width="70"
                    helpers:NavigationHelper.NavigateTo="GalgameManager.ViewModels.LibraryViewModel">
                    <NavigationViewItem.Content>
                        <Grid
                            Width="60"
                            Height="65"
                            Margin="-12,0,-20,0">
                            <FontIcon
                                Margin="0,18,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="16"
                                Glyph="&#xE8B7;" />
                            <TextBlock
                                x:Uid="Shell_LibraryText"
                                Margin="0,0,0,16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                FontSize="12"
                                TextAlignment="Center"
                                TextWrapping="NoWrap" />
                        </Grid>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <NavigationViewItem
                    x:Name="CategoryNavItem"
                    Width="70"
                    helpers:NavigationHelper.NavigateTo="GalgameManager.ViewModels.CategoryViewModel">
                    <NavigationViewItem.Content>
                        <Grid
                            Width="60"
                            Height="65"
                            Margin="-12,0,-20,0">
                            <FontIcon
                                Margin="0,18,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="16"
                                Glyph="&#xE7C1;" />
                            <TextBlock
                                x:Uid="Shell_CategoryText"
                                Margin="0,0,0,16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                FontSize="12"
                                TextAlignment="Center"
                                TextWrapping="NoWrap" />
                        </Grid>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <!--  这里的导航项是隐藏的，只是为了让导航项的命令能够被触发  -->
                <NavigationViewItem
                    x:Uid="Shell_UpdateContent"
                    helpers:NavigationHelper.NavigateTo="GalgameManager.ViewModels.UpdateContentViewModel"
                    Visibility="Collapsed" />
                <NavigationViewItem
                    x:Uid="Shell_GalgamePage"
                    helpers:NavigationHelper.NavigateTo="GalgameManager.ViewModels.GalgameViewModel"
                    Visibility="Collapsed" />
                <NavigationViewItem
                    x:Uid="Shell_GalgameSetting"
                    helpers:NavigationHelper.NavigateTo="GalgameManager.ViewModels.GalgameSettingViewModel"
                    Visibility="Collapsed" />
                <NavigationViewItem
                    x:Uid="Shell_Staff"
                    helpers:NavigationHelper.NavigateTo="GalgameManager.ViewModels.StaffViewModel"
                    Visibility="Collapsed" />
                <NavigationViewItem
                    x:Uid="Shell_GalgameCharacter"
                    helpers:NavigationHelper.NavigateTo="GalgameManager.ViewModels.GalgameCharacterViewModel"
                    Visibility="Collapsed" />
                <NavigationViewItem
                    x:Uid="Shell_SourceScanResult"
                    helpers:NavigationHelper.NavigateTo="GalgameManager.ViewModels.ScanResultViewModel"
                    Visibility="Collapsed" />
                <NavigationViewItem
                    x:Uid="Shell_PluginStore"
                    helpers:NavigationHelper.NavigateTo="GalgameManager.ViewModels.PluginStoreViewModel"
                    Visibility="Collapsed" />
            </NavigationView.MenuItems>

            <!--  年度报告  -->
            <NavigationView.FooterMenuItems>
                <NavigationViewItem
                    x:Name="AnnualReportNavItem"
                    Width="70"
                    helpers:NavigationHelper.NavigateTo="GalgameManager.ViewModels.AnnualReportViewModel"
                    Visibility="Visible">
                    <NavigationViewItem.Content>
                        <Grid
                            Width="60"
                            Height="65"
                            Margin="-12,0,-20,0">
                            <FontIcon
                                Margin="0,18,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="16"
                                Glyph="&#xE734;" />
                            <TextBlock
                                x:Uid="Shell_AnnualReportText"
                                Margin="0,0,0,16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                FontSize="12"
                                TextAlignment="Center"
                                TextWrapping="NoWrap" />
                        </Grid>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <NavigationViewItem
                    x:Name="InfoNavItem"
                    Width="70"
                    helpers:NavigationHelper.NavigateTo="GalgameManager.ViewModels.InfoViewModel">
                    <NavigationViewItem.Content>
                        <Grid
                            Width="60"
                            Height="65"
                            Margin="-12,0,-20,0">
                            <FontIcon
                                Margin="0,18,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="16"
                                Glyph="&#xE770;" />
                            <TextBlock
                                x:Uid="Shell_InfoText"
                                Margin="0,0,0,16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                FontSize="12"
                                TextAlignment="Center"
                                TextWrapping="NoWrap" />

                            <!--  InfoBadge 放置在Grid内，使用定位确保在右上角  -->
                            <InfoBadge
                                Margin="0,4,4,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Visibility="{x:Bind ViewModel.InfoPageBadgeVisibility, Mode=OneWay}"
                                Value="{x:Bind ViewModel.InfoPageBadgeCount, Mode=OneWay}" />
                        </Grid>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <NavigationViewItem
                    x:Name="HelpNavItem"
                    Width="70"
                    helpers:NavigationHelper.NavigateTo="GalgameManager.ViewModels.HelpViewModel">
                    <NavigationViewItem.Content>
                        <Grid
                            Width="60"
                            Height="65"
                            Margin="-12,0,-20,0">
                            <FontIcon
                                Margin="0,18,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="16"
                                Glyph="&#xE897;" />
                            <TextBlock
                                x:Uid="Shell_HelpText"
                                Margin="0,0,0,16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                FontSize="12"
                                TextAlignment="Center"
                                TextWrapping="NoWrap" />
                        </Grid>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <NavigationViewItem
                    x:Name="AccountNavItem"
                    Width="70"
                    helpers:NavigationHelper.NavigateTo="GalgameManager.ViewModels.AccountViewModel">
                    <NavigationViewItem.Content>
                        <Grid
                            Width="60"
                            Height="65"
                            Margin="-12,0,-20,0">
                            <FontIcon
                                Margin="0,18,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="16"
                                Glyph="&#xE77B;" />
                            <TextBlock
                                x:Uid="Shell_AccountText"
                                Margin="0,0,0,16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                FontSize="12"
                                TextAlignment="Center"
                                TextWrapping="NoWrap" />
                        </Grid>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <NavigationViewItem
                    x:Name="PluginNavItem"
                    Width="70"
                    helpers:NavigationHelper.NavigateTo="GalgameManager.ViewModels.PluginViewModel">
                    <NavigationViewItem.Content>
                        <Grid
                            Width="60"
                            Height="65"
                            Margin="-12,0,-20,0">
                            <FontIcon
                                Margin="0,18,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Glyph="&#xE74C;"
                                FontSize="16"/>
                            <TextBlock
                                x:Uid="Shell_Plugin"
                                Margin="0,0,0,16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                FontSize="12"
                                TextAlignment="Center"
                                TextWrapping="NoWrap" />
                        </Grid>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <NavigationViewItem
                    x:Name="SettingsNavItem"
                    Width="70"
                    helpers:NavigationHelper.NavigateTo="GalgameManager.ViewModels.SettingsViewModel">
                    <NavigationViewItem.Content>
                        <Grid
                            Width="60"
                            Height="65"
                            Margin="-12,0,-20,0">
                            <FontIcon
                                Margin="0,18,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="16"
                                Glyph="&#xE713;" />
                            <TextBlock
                                x:Uid="Shell_SettingsText"
                                Margin="0,0,0,16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                FontSize="12"
                                TextAlignment="Center"
                                TextWrapping="NoWrap" />

                            <InfoBadge
                                Margin="0,4,4,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Visibility="{x:Bind ViewModel.UpdateBadgeVisibility, Mode=OneWay}"
                                Value="1" />
                        </Grid>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <NavigationView.HeaderTemplate>
                <DataTemplate>
                    <Grid>
                        <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="{Binding}" />
                    </Grid>
                </DataTemplate>
            </NavigationView.HeaderTemplate>

            <Grid Margin="{StaticResource NavigationViewPageContentMargin}">
                <Frame x:Name="NavigationFrame" Grid.Row="0" />

                <Grid
                    Grid.Row="0"
                    Margin="0,0,10,40"
                    VerticalAlignment="Bottom">
                    <StackPanel Spacing="7">
                        <InfoBar
                            Title="{x:Bind ViewModel.InfoBarTitle, Mode=OneWay}"
                            IsOpen="{x:Bind ViewModel.IsInfoBarOpen, Mode=OneWay}"
                            Message="{x:Bind ViewModel.InfoBarMessage, Mode=OneWay}"
                            Severity="{x:Bind ViewModel.InfoBarSeverity, Mode=OneWay}" />

                        <!--  Event  -->
                        <ItemsRepeater VerticalAlignment="Bottom" ItemsSource="{x:Bind ViewModel.ShellEvents}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="7" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:ShellEventViewModel">
                                    <InfoBar
                                        Title="{x:Bind Title}"
                                        IsClosable="False"
                                        IsOpen="True"
                                        Message="{x:Bind Message}"
                                        Severity="{x:Bind Severity}">
                                        <InfoBar.ActionButton>
                                            <HyperlinkButton
                                                Margin="0"
                                                Command="{x:Bind ExecuteCallbackCommand}"
                                                Content="{x:Bind CallbackButtonText}" />
                                        </InfoBar.ActionButton>
                                    </InfoBar>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Page>
