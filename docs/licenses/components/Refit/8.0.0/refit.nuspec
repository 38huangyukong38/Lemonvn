<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata minClientVersion="2.12">
    <id>Refit</id>
    <version>8.0.0</version>
    <authors>.NET Foundation and Contributors</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <icon>refit_logo.png</icon>
    <readme>README.md</readme>
    <projectUrl>https://github.com/reactiveui/refit</projectUrl>
    <description>The automatic type-safe REST library for Xamarin and .NET</description>
    <copyright>Copyright (c) .NET Foundation and Contributors</copyright>
    <repository type="git" url="https://github.com/reactiveui/refit.git" branch="refs/heads/main" commit="8f9663a4f0e558a9965c01a8201fd7ecadb4eaed" />
    <dependencies>
      <group targetFramework=".NETFramework4.6.2">
        <dependency id="System.Net.Http.Json" version="8.0.1" exclude="Build,Analyzers" />
        <dependency id="System.Text.Json" version="8.0.5" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net6.0" />
      <group targetFramework="net8.0" />
      <group targetFramework=".NETStandard2.0">
        <dependency id="System.Net.Http.Json" version="8.0.1" exclude="Build,Analyzers" />
        <dependency id="System.Text.Json" version="8.0.5" exclude="Build,Analyzers" />
      </group>
    </dependencies>
    <frameworkAssemblies>
      <frameworkAssembly assemblyName="System.Web" targetFramework=".NETFramework4.6.2" />
    </frameworkAssemblies>
  </metadata>
</package>